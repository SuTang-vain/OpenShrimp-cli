{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenShrimp",
  "version": "0.2.0",
  "identifier": "com.openshrimp.app",
  "build": {
    "beforeDevCommand": "cd ../ui && npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd ../ui && npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenShrimp",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "com.openshrimp.app",
    "longDescription": "OpenShrimp - A unified CLI and Desktop UI tool for managing AI development tools on macOS and Linux.",
    "shortDescription": "AI Tools Manager",
    "copyright": "Copyright © 2024 OpenShrimp. All rights reserved.",
    "deb": {
      "depends": ["webkit2gtk", "gtk3.0", "libayatana-appindicator", "libnotify"]
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "allowlist": {
    "all": false,
    "shell": {
      "all": false,
      "open": true
    },
    "window": {
      "all": true
    },
    "process": {
      "all": true
    },
    "fs": {
      "all": true,
      "readFile": true,
      "writeFile": true,
      "readDir": true,
      "copyFile": true,
      "createDir": true,
      "removeFile": true,
      "removeDir": true,
      "renameFile": true,
      "exists": true
    },
    "path": {
      "all": true
    },
    "os": {
      "all": true
    },
    "notification": {
      "all": true
    },
    "dialog": {
      "all": true,
      "open": true,
      "save": true,
      "message": true,
      "ask": true,
      "confirm": true
    },
    "clipboard": {
      "all": true
    },
    "http": {
      "all": true,
      "scope": ["http://127.0.0.1:19999/*", "https://api.anthropic.com/*"]
    }
  }
}
